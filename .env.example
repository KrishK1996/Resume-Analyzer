# Groq API Key (Get your free key from https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model Selection (default: llama-3.3-70b-versatile, fallback: llama-3.1-8b-instant)
GROQ_MODEL=llama-3.3-70b-versatile

# Server Port (default: 8000 for backend API, 8501 for production full-stack / EC2)
PORT=8000
HOST=0.0.0.0
